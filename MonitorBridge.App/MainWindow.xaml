<Window x:Class="MonitorBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorBridge"
        Height="760"
        Width="1150"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Loaded="Window_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="MonitorBridge"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Monitor Control Center"
                           FontSize="13"
                           Foreground="#94A3B8"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Monitor selection -->
        <Border Grid.Row="1"
                Background="#1E293B"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SELECT DISPLAY"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="MonitorComboBox"
                              Width="300"
                              Height="36"
                              Margin="0,10,0,0"
                              HorizontalAlignment="Left"
                              SelectionChanged="MonitorComboBox_SelectionChanged"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Width="100"
                        Height="36"
                        Margin="12,22,0,0"
                        Click="Refresh_Click"/>

                <Button x:Name="StartStopButton"
                        Grid.Column="2"
                        Content="Start Preview"
                        Width="140"
                        Height="36"
                        Margin="12,22,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="StartStop_Click"/>

                <Button Grid.Column="3"
                        Content="Test Mouse"
                        Width="110"
                        Height="36"
                        Margin="12,22,0,0"
                        Click="TestMouse_Click"/>
            </Grid>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="2"
                Background="#1E293B"
                CornerRadius="12"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="LIVE PREVIEW"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,12"/>

                <Border Grid.Row="1"
                        Background="#020617"
                        CornerRadius="8"
                        ClipToBounds="True">

                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Fill"
                               Focusable="True"
                               MouseDown="PreviewImage_MouseDown"
                               MouseWheel="PreviewImage_MouseWheel"
                               MouseMove="PreviewImage_MouseWheel"/>

                        <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="No preview available"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Select a display and start preview"
                                       Foreground="#64748B"
                                       FontSize="13"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Ready"
                   Foreground="#94A3B8"
                   FontSize="12"
                   Margin="0,16,0,0"/>

    </Grid>
</Window>
